trigger:
  branches:
    include:
    - main
    - develop
    - feat/*
    - fix/*
  paths:
    exclude:
    - README.md
    - docs/*

variables:
  # Docker/ECR Configuration
  AWS_REGION: 'us-east-1'
  ECR_REPOSITORY: 'my-application'
  IMAGE_TAG: '$(Build.BuildNumber)'
  
  # EKS Configuration
  EKS_CLUSTER_NAME: 'my-eks-cluster'
  
  # Helm Configuration
  HELM_CHART_PATH: './helm-chart'
  HELM_RELEASE_NAME: 'my-app'
  
  # Application Configuration
  DOCKERFILE_PATH: './Dockerfile'

stages:
- stage: Build
  displayName: 'Build and Push Docker Image'
  jobs:
  - job: BuildJob
    displayName: 'Build Application'
    pool:
      vmImage: 'ubuntu-latest'
    
    steps:
    - task: UseNode@1
      displayName: 'Setup Node.js'
      inputs:
        version: '18.x'
    
    - script: |
        npm ci
        npm run build
        npm run test
      displayName: 'Install dependencies and run tests'
    
    # Only push to ECR if branch is main or develop
    - task: AWSShellScript@1
      displayName: 'Configure AWS CLI'
      condition: or(eq(variables['Build.SourceBranch'], 'refs/heads/main'), eq(variables['Build.SourceBranch'], 'refs/heads/develop'))
      inputs:
        awsCredentials: 'AWS-ServiceConnection'
        regionName: $(AWS_REGION)
        scriptType: 'inline'
        inlineScript: |
          # Login to ECR
          aws ecr get-login-password --region $(AWS_REGION) | docker login --username AWS --password-stdin $(AWS_ACCOUNT_ID).dkr.ecr.$(AWS_REGION).amazonaws.com
          
          # Create ECR repository if it doesn't exist
          aws ecr describe-repositories --repository-names $(ECR_REPOSITORY) --region $(AWS_REGION) || \
          aws ecr create-repository --repository-name $(ECR_REPOSITORY) --region $(AWS_REGION)
    
    - task: Docker@2
      displayName: 'Build Docker Image'
      inputs:
        command: 'build'
        dockerfile: $(DOCKERFILE_PATH)
        tags: |
          $(AWS_ACCOUNT_ID).dkr.ecr.$(AWS_REGION).amazonaws.com/$(ECR_REPOSITORY):$(IMAGE_TAG)
          $(AWS_ACCOUNT_ID).dkr.ecr.$(AWS_REGION).amazonaws.com/$(ECR_REPOSITORY):latest
    
    - task: AWSShellScript@1
      displayName: 'Push Docker Image to ECR'
      condition: or(eq(variables['Build.SourceBranch'], 'refs/heads/main'), eq(variables['Build.SourceBranch'], 'refs/heads/develop'))
      inputs:
        awsCredentials: 'AWS-ServiceConnection'
        regionName: $(AWS_REGION)
        scriptType: 'inline'
        inlineScript: |
          # Push images to ECR
          docker push $(AWS_ACCOUNT_ID).dkr.ecr.$(AWS_REGION).amazonaws.com/$(ECR_REPOSITORY):$(IMAGE_TAG)
          docker push $(AWS_ACCOUNT_ID).dkr.ecr.$(AWS_REGION).amazonaws.com/$(ECR_REPOSITORY):latest
    
    - task: PublishBuildArtifacts@1
      displayName: 'Publish Helm Charts'
      condition: or(eq(variables['Build.SourceBranch'], 'refs/heads/main'), eq(variables['Build.SourceBranch'], 'refs/heads/develop'))
      inputs:
        pathToPublish: $(HELM_CHART_PATH)
        artifactName: 'helm-charts'

- stage: DeployDEV
  displayName: 'Deploy to DEV Environment'
  dependsOn: Build
  condition: and(succeeded(), eq(variables['Build.SourceBranch'], 'refs/heads/develop'))
  jobs:
  - deployment: DeployToDEV
    displayName: 'Deploy to DEV'
    pool:
      vmImage: 'ubuntu-latest'
    environment: 'DEV'
    strategy:
      runOnce:
        deploy:
          steps:
          - download: current
            artifact: helm-charts
          
          - task: HelmInstaller@0
            displayName: 'Install Helm'
            inputs:
              helmVersion: '3.12.0'
          
          - task: AWSShellScript@1
            displayName: 'Configure kubectl and Deploy to DEV'
            inputs:
              awsCredentials: 'AWS-ServiceConnection'
              regionName: $(AWS_REGION)
              scriptType: 'inline'
              inlineScript: |
                # Configure kubectl for EKS
                aws eks update-kubeconfig --region $(AWS_REGION) --name $(EKS_CLUSTER_NAME)-dev
                
                # Create namespace if it doesn't exist
                kubectl create namespace dev --dry-run=client -o yaml | kubectl apply -f -
                
                # Deploy using Helm
                helm upgrade --install $(HELM_RELEASE_NAME) $(Pipeline.Workspace)/helm-charts/helm-charts \
                  --namespace dev \
                  --set image.repository=$(AWS_ACCOUNT_ID).dkr.ecr.$(AWS_REGION).amazonaws.com/$(ECR_REPOSITORY) \
                  --set image.tag=$(IMAGE_TAG) \
                  --set environment=dev \
                  --set ingress.host=dev-myapp.example.com \
                  --wait --timeout=10m
                
                # Verify deployment
                kubectl get pods -n dev -l app=$(HELM_RELEASE_NAME)
                kubectl get services -n dev -l app=$(HELM_RELEASE_NAME)

- stage: DeployHML
  displayName: 'Deploy to HML Environment'
  dependsOn: Build
  condition: and(succeeded(), or(eq(variables['Build.SourceBranch'], 'refs/heads/main'), eq(variables['Build.SourceBranch'], 'refs/heads/develop')))
  jobs:
  - deployment: DeployToHML
    displayName: 'Deploy to HML'
    pool:
      vmImage: 'ubuntu-latest'
    environment: 'HML'  # This environment requires approval in Azure DevOps
    strategy:
      runOnce:
        deploy:
          steps:
          - download: current
            artifact: helm-charts
          
          - task: HelmInstaller@0
            displayName: 'Install Helm'
            inputs:
              helmVersion: '3.12.0'
          
          - task: AWSShellScript@1
            displayName: 'Configure kubectl and Deploy to HML'
            inputs:
              awsCredentials: 'AWS-ServiceConnection'
              regionName: $(AWS_REGION)
              scriptType: 'inline'
              inlineScript: |
                # Configure kubectl for EKS
                aws eks update-kubeconfig --region $(AWS_REGION) --name $(EKS_CLUSTER_NAME)-hml
                
                # Create namespace if it doesn't exist
                kubectl create namespace hml --dry-run=client -o yaml | kubectl apply -f -
                
                # Deploy using Helm - same build artifact for all environments
                helm upgrade --install $(HELM_RELEASE_NAME) $(Pipeline.Workspace)/helm-charts/helm-charts \
                  --namespace hml \
                  --set image.repository=$(AWS_ACCOUNT_ID).dkr.ecr.$(AWS_REGION).amazonaws.com/$(ECR_REPOSITORY) \
                  --set image.tag=$(IMAGE_TAG) \
                  --set environment=hml \
                  --set ingress.host=hml-myapp.example.com \
                  --wait --timeout=10m
                
                # Verify deployment
                kubectl get pods -n hml -l app=$(HELM_RELEASE_NAME)
                kubectl get services -n hml -l app=$(HELM_RELEASE_NAME)

- stage: DeployPRD
  displayName: 'Deploy to PRD Environment'
  dependsOn: DeployHML
  condition: and(succeeded(), eq(variables['Build.SourceBranch'], 'refs/heads/main'))
  jobs:
  - deployment: DeployToPRD
    displayName: 'Deploy to PRD'
    pool:
      vmImage: 'ubuntu-latest'
    environment: 'PRD'  # This environment requires approval in Azure DevOps
    strategy:
      runOnce:
        deploy:
          steps:
          - download: current
            artifact: helm-charts
          
          - task: HelmInstaller@0
            displayName: 'Install Helm'
            inputs:
              helmVersion: '3.12.0'
          
          - task: AWSShellScript@1
            displayName: 'Configure kubectl and Deploy to PRD'
            inputs:
              awsCredentials: 'AWS-ServiceConnection'
              regionName: $(AWS_REGION)
              scriptType: 'inline'
              inlineScript: |
                # Configure kubectl for EKS
                aws eks update-kubeconfig --region $(AWS_REGION) --name $(EKS_CLUSTER_NAME)-prd
                
                # Create namespace if it doesn't exist
                kubectl create namespace prd --dry-run=client -o yaml | kubectl apply -f -
                
                # Deploy using Helm - same build artifact used across all environments
                helm upgrade --install $(HELM_RELEASE_NAME) $(Pipeline.Workspace)/helm-charts/helm-charts \
                  --namespace prd \
                  --set image.repository=$(AWS_ACCOUNT_ID).dkr.ecr.$(AWS_REGION).amazonaws.com/$(ECR_REPOSITORY) \
                  --set image.tag=$(IMAGE_TAG) \
                  --set environment=prd \
                  --set ingress.host=myapp.example.com \
                  --set replicaCount=3 \
                  --set resources.requests.cpu=200m \
                  --set resources.requests.memory=256Mi \
                  --set resources.limits.cpu=500m \
                  --set resources.limits.memory=512Mi \
                  --wait --timeout=15m
                
                # Verify deployment
                kubectl get pods -n prd -l app=$(HELM_RELEASE_NAME)
                kubectl get services -n prd -l app=$(HELM_RELEASE_NAME)
                
                # Run smoke tests
                echo "Running smoke tests..."
                kubectl wait --for=condition=ready pod -l app=$(HELM_RELEASE_NAME) -n prd --timeout=300s
                
                # Get service endpoint for verification
                kubectl get ingress -n prd

