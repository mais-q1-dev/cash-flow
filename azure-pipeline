trigger:
  branches:
    include:
      - main
      - feat/*
      - fix/*

variables:
  awsRegion: 'us-east-1'
  eksCluster: 'my-eks-cluster'
  ecrRepoUrl: '<aws_account_id>.dkr.ecr.us-east-1.amazonaws.com/my-app'
  k8sNamespace: 'default'
  cpuRequest: '100m'
  memoryRequest: '128Mi'
  cpuLimit: '500m'
  memoryLimit: '512Mi'

stages:

# Stage: Build and Publish Artifact
- stage: Build
  displayName: Build and Test
  jobs:
  - job: BuildJob
    displayName: Build and Push Docker Image
    pool:
      vmImage: 'ubuntu-latest'
    steps:
    - task: Checkout@1

    - task: Docker@2
      displayName: 'Build and Push Docker Image'
      inputs:
        containerRegistry: 'aws-ecr-service-connection'
        repository: 'my-app'
        command: 'buildAndPush'
        Dockerfile: '**/Dockerfile'
        tags: |
          $(Build.BuildId)

    - publish: $(System.DefaultWorkingDirectory)
      artifact: drop

# Stage: Deploy to DEV
- stage: Deploy_DEV
  displayName: Deploy to DEV
  dependsOn: Build
  condition: succeeded()
  variables:
    environment: 'dev'
  jobs:
  - job: DeployDev
    displayName: Deploy to DEV via Helm
    pool:
      vmImage: 'ubuntu-latest'
    steps:
    - download: current
      artifact: drop

    - task: AWSCLI@1
      displayName: 'Configure AWS Credentials'
      inputs:
        awsCredentials: 'aws-service-connection'
        regionName: $(awsRegion)
        command: 'sts'
        arguments: 'get-caller-identity'

    - script: |
        aws eks update-kubeconfig --region $(awsRegion) --name $(eksCluster)
        kubectl get nodes
      displayName: 'Test EKS Connection'

    - script: |
        helm upgrade --install my-app-$(environment) helm/chart \
          --namespace $(k8sNamespace) \
          --create-namespace \
          --set image.repository=$(ecrRepoUrl) \
          --set image.tag=$(Build.BuildId) \
          --set resources.requests.cpu=$(cpuRequest) \
          --set resources.requests.memory=$(memoryRequest) \
          --set resources.limits.cpu=$(cpuLimit) \
          --set resources.limits.memory=$(memoryLimit)
      displayName: 'Helm Deploy to DEV'

# Stage: Deploy to HML (with approval)
- stage: Deploy_HML
  displayName: Deploy to HML
  dependsOn: Build
  condition: succeeded()
  variables:
    environment: 'hml'
  jobs:
  - job: DeployHml
    displayName: Deploy to HML via Helm
    pool:
      vmImage: 'ubuntu-latest'
    steps:
    - download: current
      artifact: drop

    - task: AWSCLI@1
      displayName: 'Configure AWS Credentials'
      inputs:
        awsCredentials: 'aws-service-connection'
        regionName: $(awsRegion)
        command: 'sts'
        arguments: 'get-caller-identity'

    - script: |
        aws eks update-kubeconfig --region $(awsRegion) --name $(eksCluster)
        kubectl get nodes
      displayName: 'Test EKS Connection'

    - script: |
        helm upgrade --install my-app-$(environment) helm/chart \
          --namespace $(k8sNamespace) \
          --create-namespace \
          --set image.repository=$(ecrRepoUrl) \
          --set image.tag=$(Build.BuildId) \
          --set resources.requests.cpu=$(cpuRequest) \
          --set resources.requests.memory=$(memoryRequest) \
          --set resources.limits.cpu=$(cpuLimit) \
          --set resources.limits.memory=$(memoryLimit)
      displayName: 'Helm Deploy to HML'
  environment: 'hml'

# Stage: Deploy to PROD (only if branch is main and after HML)
- stage: Deploy_PROD
  displayName: Deploy to PROD
  dependsOn: Deploy_HML
  condition: and(succeeded(), eq(variables['Build.SourceBranch'], 'refs/heads/main'))
  variables:
    environment: 'prod'
  jobs:
  - job: DeployProd
    displayName: Deploy to PROD via Helm
    pool:
      vmImage: 'ubuntu-latest'
    steps:
    - download: current
      artifact: drop

    - task: AWSCLI@1
      displayName: 'Configure AWS Credentials'
      inputs:
        awsCredentials: 'aws-service-connection'
        regionName: $(awsRegion)
        command: 'sts'
        arguments: 'get-caller-identity'

    - script: |
        aws eks update-kubeconfig --region $(awsRegion) --name $(eksCluster)
        kubectl get nodes
      displayName: 'Test EKS Connection'

    - script: |
        helm upgrade --install my-app-$(environment) helm/chart \
          --namespace $(k8sNamespace) \
          --create-namespace \
          --set image.repository=$(ecrRepoUrl) \
          --set image.tag=$(Build.BuildId) \
          --set resources.requests.cpu=$(cpuRequest) \
          --set resources.requests.memory=$(memoryRequest) \
          --set resources.limits.cpu=$(cpuLimit) \
          --set resources.limits.memory=$(memoryLimit)
      displayName: 'Helm Deploy to PROD'
  environment: 'prod'

