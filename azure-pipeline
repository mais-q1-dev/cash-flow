trigger:
  branches:
    include:
      - main  # Ou a branch que desejar

variables:
  AWS_REGION: 'us-east-1'  # Substitua pela região correta
  ECR_REPOSITORY: '123456789012.dkr.ecr.us-east-1.amazonaws.com/seu-repo'
  IMAGE_TAG: 'latest'  # Ou use $(Build.BuildId) para versionamento
  K8S_NAMESPACE: 'seu-namespace'
  HELM_CHART_PATH: 'helm/'  # Caminho onde está o chart
  RELEASE_NAME: 'minha-aplicacao'
  AWS_SERVICE_CONNECTION: 'aws-devops-connection'  # Nome da Service Connection criada

stages:
- stage: Deploy
  displayName: "Deploy para AWS EKS"
  jobs:
  - job: DeployToEKS
    displayName: "Publicar no Kubernetes via Helm"
    pool:
      vmImage: 'ubuntu-latest'
    
    steps:
    - task: AWSShellScript@1
      name: ECRLogin
      displayName: "Login no Amazon ECR"
      inputs:
        awsCredentials: '$(AWS_SERVICE_CONNECTION)'
        regionName: '$(AWS_REGION)'
        scriptType: 'inline'
        inlineScript: |
          aws ecr get-login-password --region $(AWS_REGION) | docker login --username AWS --password-stdin $(ECR_REPOSITORY)

    - task: AWSShellScript@1
      name: UpdateKubeConfig
      displayName: "Obter credenciais do cluster EKS"
      inputs:
        awsCredentials: '$(AWS_SERVICE_CONNECTION)'
        regionName: '$(AWS_REGION)'
        scriptType: 'inline'
        inlineScript: |
          aws eks update-kubeconfig --name meu-cluster --region $(AWS_REGION)

    - task: HelmInstaller@0
      displayName: "Instalar Helm"
      inputs:
        helmVersion: 'latest'

    - script: |
        helm upgrade --install $(RELEASE_NAME) $(HELM_CHART_PATH) \
          --namespace $(K8S_NAMESPACE) \
          --set image.repository=$(ECR_REPOSITORY) \
          --set image.tag=$(IMAGE_TAG)
