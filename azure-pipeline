trigger:
- main

variables:
  dockerfilePath: '**/Dockerfile'
  imageRepository: 'your-ecr-repo-name'
  awsRegion: 'your-aws-region'  # e.g., us-east-1
  eksClusterName: 'your-eks-cluster'
  helmChartPath: 'charts/your-app'  # Path to your Helm chart
  helmReleaseName: 'your-app-release'
  awsAccountId: 'your-aws-account-id'

stages:
- stage: Build
  displayName: Build and Push Docker Image
  jobs:
  - job: Build
    displayName: Build
    pool:
      vmImage: 'ubuntu-latest'
    steps:
    - task: DockerInstaller@0
      displayName: 'Install Docker'
    
    - task: AWSCLI@1
      displayName: 'Install AWS CLI'
      inputs:
        awsRegion: $(awsRegion)
    
    - task: ConfigureAWSCredentials@1
      displayName: 'Configure AWS Credentials'
      inputs:
        awsCredentials: 'AWS_Service_Connection'
        regionName: $(awsRegion)
    
    - script: |
        aws ecr get-login-password --region $(awsRegion) | docker login --username AWS --password-stdin $(awsAccountId).dkr.ecr.$(awsRegion).amazonaws.com
      displayName: 'Login to AWS ECR'
    
    - task: Docker@2
      displayName: 'Build and Push Docker Image'
      inputs:
        command: buildAndPush
        repository: $(imageRepository)
        dockerfile: $(dockerfilePath)
        containerRegistry: 'AWS_ECR_Registry'
        tags: |
          $(Build.BuildId)
          latest
    
    - task: HelmInstaller@1
      displayName: 'Install Helm'
      inputs:
        helmVersion: '3.12.0'
    
    - task: CopyFiles@2
      displayName: 'Copy Helm Charts'
      inputs:
        SourceFolder: '$(helmChartPath)'
        Contents: '**'
        TargetFolder: '$(Build.ArtifactStagingDirectory)/charts'
    
    - task: PublishPipelineArtifact@1
      displayName: 'Publish Helm Charts'
      inputs:
        targetPath: '$(Build.ArtifactStagingDirectory)/charts'
        artifact: 'helm-charts'
        publishLocation: 'pipeline'

- stage: DeployToHML
  displayName: 'Deploy to HML'
  dependsOn: Build
  condition: succeeded()
  jobs:
  - deployment: DeployHML
    displayName: 'Deploy to HML'
    environment: 'HML'
    strategy:
      runOnce:
        deploy:
          steps:
          - task: DownloadPipelineArtifact@2
            displayName: 'Download Helm Charts'
            inputs:
              buildType: 'current'
              artifactName: 'helm-charts'
              targetPath: '$(Pipeline.Workspace)/charts'
          
          - task: AWSCLI@1
            displayName: 'Install AWS CLI'
          
          - task: ConfigureAWSCredentials@1
            displayName: 'Configure AWS Credentials'
            inputs:
              awsCredentials: 'AWS_Service_Connection'
              regionName: $(awsRegion)
          
          - task: HelmDeploy@0
            displayName: 'Install kubectl and configure EKS'
            inputs:
              connectionType: 'AWS'
              awsAccountEndpoint: 'AWS_Service_Connection'
              awsRegion: $(awsRegion)
              clusterName: $(eksClusterName)
              command: 'login'
          
          - task: HelmDeploy@0
            displayName: 'Deploy to HML with Helm'
            inputs:
              command: 'upgrade'
              chartType: 'FilePath'
              chartPath: '$(Pipeline.Workspace)/charts/your-app'
              releaseName: $(helmReleaseName)
              namespace: 'hml'
              valueFile: '$(Pipeline.Workspace)/charts/your-app/values-hml.yaml'
              overrideValues: |
                image.repository=$(awsAccountId).dkr.ecr.$(awsRegion).amazonaws.com/$(imageRepository)
                image.tag=$(Build.BuildId)
              waitForExecution: true

- stage: ApprovePRD
  displayName: 'Approve PRD Deployment'
  dependsOn: DeployToHML
  condition: succeeded()
  jobs:
  - job: ApprovePRD
    displayName: 'Wait for PRD approval'
    pool: server
    steps:
    - task: ManualValidation@0
      displayName: 'Wait for PRD approval'
      timeoutInMinutes: 1440 # 24 hours
      inputs:
        notifyUsers: |
          prd-approvers@yourcompany.com
          team-lead@yourcompany.com
        instructions: 'Please review the HML deployment and approve for PRD'

- stage: DeployToPRD
  displayName: 'Deploy to PRD'
  dependsOn: ApprovePRD
  condition: succeeded()
  jobs:
  - deployment: DeployPRD
    displayName: 'Deploy to PRD'
    environment: 'PRD'
    strategy:
      runOnce:
        deploy:
