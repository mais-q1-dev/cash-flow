trigger:
  branches:
    include:
      - main
      - develop
      - feat/*
      - fix/*

variables:
  - name: dockerfilePath
    value: '**/Dockerfile'
  - name: imageRepository
    value: 'your-ecr-repo-name'
  - name: awsRegion
    value: 'your-aws-region'
  - name: eksClusterName
    value: 'your-eks-cluster'
  - name: helmChartPath
    value: 'charts/your-app'
  - name: helmReleaseName
    value: 'your-app-release'
  - name: awsAccountId
    value: 'your-aws-account-id'
  - name: isMainBranch
    value: $[eq(variables['Build.SourceBranch'], 'refs/heads/main')]
  - name: isDevelopBranch
    value: $[eq(variables['Build.SourceBranch'], 'refs/heads/develop')]
  - name: isFeatureBranch
    value: $[or(startsWith(variables['Build.SourceBranch'], 'refs/heads/feat/'),
               startsWith(variables['Build.SourceBranch'], 'refs/heads/fix/'))]

stages:
- stage: Build
  displayName: Build and Test
  jobs:
  - job: BuildAndTest
    displayName: 'Build, Push and Test'
    pool:
      vmImage: 'ubuntu-latest'
    steps:
    - task: DockerInstaller@0
      displayName: 'Install Docker'
    
    - task: AWSCLI@1
      displayName: 'Install AWS CLI'
      inputs:
        awsRegion: $(awsRegion)
    
    - task: ConfigureAWSCredentials@1
      displayName: 'Configure AWS Credentials'
      inputs:
        awsCredentials: 'AWS_Service_Connection'
        regionName: $(awsRegion)
    
    - script: |
        aws ecr get-login-password --region $(awsRegion) | docker login --username AWS --password-stdin $(awsAccountId).dkr.ecr.$(awsRegion).amazonaws.com
      displayName: 'Login to AWS ECR'
    
    - task: Docker@2
      displayName: 'Build and Push Docker Image'
      inputs:
        command: buildAndPush
        repository: $(imageRepository)
        dockerfile: $(dockerfilePath)
        containerRegistry: 'AWS_ECR_Registry'
        tags: |
          $(Build.BuildId)
          latest
    
    - task: HelmInstaller@1
      displayName: 'Install Helm'
      inputs:
        helmVersion: '3.12.0'
    
    - task: CopyFiles@2
      displayName: 'Copy Helm Charts'
      inputs:
        SourceFolder: '$(helmChartPath)'
        Contents: '**'
        TargetFolder: '$(Build.ArtifactStagingDirectory)/charts'
    
    - task: PublishPipelineArtifact@1
      displayName: 'Publish Helm Charts'
      inputs:
        targetPath: '$(Build.ArtifactStagingDirectory)/charts'
        artifact: 'helm-charts'
        publishLocation: 'pipeline'
    
    # Unit Tests Stage
    - script: |
        echo "Running unit tests..."
        # Add your test commands here
        # Example: npm test or pytest
      displayName: 'Run Unit Tests'
      condition: succeeded()

    # Integration Tests (only for feature branches)
    - script: |
        echo "Running integration tests..."
        # Add your integration test commands here
      displayName: 'Run Integration Tests'
      condition: and(succeeded(), eq(variables.isFeatureBranch, true))

- stage: DeployToDEV
  displayName: 'Deploy to DEV'
  dependsOn: Build
  condition: and(succeeded(), or(eq(variables.isDevelopBranch, true), eq(variables.isFeatureBranch, true)))
  jobs:
  - deployment: DeployDEV
    displayName: 'Deploy to DEV'
    environment: 'DEV'
    strategy:
      runOnce:
        deploy:
          steps:
          - task: DownloadPipelineArtifact@2
            displayName: 'Download Helm Charts'
            inputs:
              buildType: 'current'
              artifactName: 'helm-charts'
              targetPath: '$(Pipeline.Workspace)/charts'
          
          - task: AWSCLI@1
            displayName: 'Install AWS CLI'
          
          - task: ConfigureAWSCredentials@1
            displayName: 'Configure AWS Credentials'
            inputs:
              awsCredentials: 'AWS_Service_Connection'
              regionName: $(awsRegion)
          
          - task: HelmDeploy@0
            displayName: 'Configure EKS Access'
            inputs:
              connectionType: 'AWS'
              awsAccountEndpoint: 'AWS_Service_Connection'
              awsRegion: $(awsRegion)
              clusterName: $(eksClusterName)
              command: 'login'
          
          - task: HelmDeploy@0
            displayName: 'Deploy to DEV with Helm'
            inputs:
              command: 'upgrade'
              chartType: 'FilePath'
              chartPath: '$(Pipeline.Workspace)/charts/your-app'
              releaseName: $(helmReleaseName)
              namespace: 'dev'
              valueFile: '$(Pipeline.Workspace)/charts/your-app/values-dev.yaml'
              overrideValues: |
                image.repository=$(awsAccountId).dkr.ecr.$(awsRegion).amazonaws.com/$(imageRepository)
                image.tag=$(Build.BuildId)
              waitForExecution: true
              atomic: true

- stage: ApproveHML
  displayName: 'Approve HML Deployment'
  dependsOn: Build
  condition: and(succeeded(), eq(variables.isDevelopBranch, true))
  jobs:
  - job: ApproveHML
    displayName: 'Wait for HML approval'
    pool: server
    steps:
    - task: ManualValidation@0
      displayName: 'Wait for HML approval'
      timeoutInMinutes: 1440
      inputs:
        notifyUsers: |
          hml-approvers@yourcompany.com
          team-lead@yourcompany.com
        instructions: 'Please approve the deployment to HML environment'
        onTimeout: 'reject'

- stage: DeployToHML
  displayName: 'Deploy to HML'
  dependsOn: ApproveHML
  condition: and(succeeded(), eq(variables.isDevelopBranch, true))
  jobs:
  - deployment: DeployHML
    displayName: 'Deploy to HML'
    environment: 'HML'
    strategy:
      runOnce:
        deploy:
          steps:
          - task: DownloadPipelineArtifact@2
            displayName: 'Download Helm Charts'
            inputs:
              buildType: 'current'
              artifactName: 'helm-charts'
              targetPath: '$(Pipeline.Workspace)/charts'
          
          - task: AWSCLI@1
            displayName: 'Install AWS CLI'
          
          - task: ConfigureAWSCredentials@1
            displayName: 'Configure AWS Credentials'
            inputs:
              awsCredentials: 'AWS_Service_Connection'
              regionName: $(awsRegion)
          
          - task: HelmDeploy@0
            displayName: 'Configure EKS Access'
            inputs:
              connectionType: 'AWS'
              awsAccountEndpoint: 'AWS_Service_Connection'
              awsRegion: $(awsRegion)
              clusterName: $(eksClusterName)
              command: 'login'
          
          - task: HelmDeploy@0
            displayName: 'Deploy to HML with Helm'
            inputs:
              command: 'upgrade'
              chartType: 'FilePath'
              chartPath: '$(Pipeline.Workspace)/charts/your-app'
              releaseName: $(helmReleaseName)
              namespace: 'hml'
              valueFile: '$(Pipeline.Workspace)/charts/your-app/values-hml.yaml'
              overrideValues: |
                image.repository=$(awsAccountId).dkr.ecr.$(awsRegion).amazonaws.com/$(imageRepository)
                image.tag=$(Build.BuildId)
              waitForExecution: true
              atomic: true

- stage: ApprovePRD
  displayName: 'Approve PRD Deployment'
  dependsOn: Build
  condition: and(succeeded(), eq(variables.isMainBranch, true))
  jobs:
  - job: ApprovePRD
    displayName: 'Wait for PRD approval'
    pool: server
    steps:
    - task: ManualValidation@0
      displayName: 'Wait for PRD approval'
      timeoutInMinutes: 1440
      inputs:
        notifyUsers: |
          prd-approvers@yourcompany.com
          cto@yourcompany.com
        instructions: 'Please approve the deployment to PRD environment'
        onTimeout: 'reject'

- stage: DeployToPRD
  displayName: 'Deploy to PRD'
  dependsOn: ApprovePRD
  condition: and(succeeded(), eq(variables.isMainBranch, true))
  jobs:
  - deployment: DeployPRD
    displayName: 'Deploy to PRD'
    environment: 'PRD'
    strategy:
      runOnce:
        deploy:
          steps:
          - task: DownloadPipelineArtifact@2
            displayName: 'Download Helm Charts'
            inputs:
              buildType: 'current'
              artifactName: 'helm-charts'
              targetPath: '$(Pipeline.Workspace)/charts'
          
          - task: AWSCLI@1
            displayName: 'Install AWS CLI'
          
          - task: ConfigureAWSCredentials@1
            displayName: 'Configure AWS Credentials'
            inputs:
              awsCredentials: 'AWS_Service_Connection'
              regionName: $(awsRegion)
          
          - task: HelmDeploy@0
            displayName: 'Configure EKS Access'
            inputs:
              connectionType: 'AWS'
              awsAccountEndpoint: 'AWS_Service_Connection'
              awsRegion: $(awsRegion)
              clusterName: $(eksClusterName)
              command: 'login'
          
          - task: HelmDeploy@0
            displayName: 'Deploy to PRD with Helm'
            inputs:
              command: 'upgrade'
              chartType: 'FilePath'
              chartPath: '$(Pipeline.Workspace)/charts/your-app'
              releaseName: $(helmReleaseName)
              namespace: 'prd'
              valueFile: '$(Pipeline.Workspace)/charts/your-app/values-prd.yaml'
              overrideValues: |
                image.repository=$(awsAccountId).dkr.ecr.$(awsRegion).amazonaws.com/$(imageRepository)
                image.tag=$(Build.BuildId)
                replicaCount=3
              waitForExecution: true
              atomic: true
              force: true

